# Site mode: leave empty for personal site, set to "demo" for sales demo
NEXT_PUBLIC_SITE_MODE=

# Canonical URL for metadata / Open Graph
# Personal: https://your-live-domain.com
# Demo:     https://modelportfolio-demo.vercel.app
NEXT_PUBLIC_SITE_URL=

# Contact Form (EmailJS — get from emailjs.com)
